{
  "nodeModulesDir": "auto",
  "imports": {
    "react": "npm:react@19.3.0",
    "react-dom": "npm:react-dom@19.3.0",
    "react/jsx-runtime": "npm:react@19.3.0/jsx-runtime",
    "@types/react": "npm:@types/react@19.3.0",
    "@types/react-dom": "npm:@types/react-dom@19.2.3",
    "vite": "npm:vite@^6",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4",
    "tailwindcss": "npm:tailwindcss@^4",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4"
  },
  "tasks": {
    "start": "deno run --allow-read --allow-run=socat --allow-net main.ts",
    "test": "deno test --allow-read --allow-net=127.0.0.1",
    "check": "deno check main.ts src/ test/ tools/ web/src/",
    "gen-catalog": "deno run --allow-read tools/gen-catalog.ts",
    "compile": "deno run --allow-read --allow-write=dist --allow-run=deno,tar,zip tools/compile.ts",
    "web:dev": "deno run -A npm:vite@^6 --config web/vite.config.ts",
    "web:build": "deno run -A npm:vite@^6 build --config web/vite.config.ts"
  },
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": true,
    "exclude": [
      "**/*.md",
      "dist/",
      "web/dist/"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    },
    "exclude": [
      "dist/",
      "web/dist/"
    ]
  }
}
