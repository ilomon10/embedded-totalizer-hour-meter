{
  "nodeModulesDir": "auto",
  "imports": {
    "ink": "npm:ink@6.8.0",
    "ink-text-input": "npm:ink-text-input@6.0.0",
    "react": "npm:react@19.3.0",
    "@types/react": "npm:@types/react@19.3.0"
  },
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react"
  },
  "tasks": {
    "start": "deno run -A main.ts",
    "test": "deno test --allow-read --allow-env --allow-sys",
    "check": "deno check main.ts src/ test/ tools/",
    "compile": "deno run --allow-read --allow-write=dist --allow-run=deno,tar,zip --allow-env tools/compile.ts"
  },
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": true,
    "exclude": ["**/*.md", "dist/"]
  },
  "lint": {
    "rules": { "tags": ["recommended"] },
    "exclude": ["dist/"]
  }
}
