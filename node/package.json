{
  "name": "totalizer-hour-meter-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Host tools for the hour-meter ESP32: live reader, command CLI, DeviceClient.",
  "main": "device.js",
  "scripts": {
    "start": "node reader.js",
    "cmd": "node commands.js",
    "test": "node --test 'test/**/*.test.js' && tsx --test 'tui/**/*.test.ts'",
    "tui": "tsx tui/main.tsx",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0",
    "sensorframe": "file:../sensorframe/js",
    "serialport": "^12.0.0"
  },
  "bin": {
    "hour-meter": "commands.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
