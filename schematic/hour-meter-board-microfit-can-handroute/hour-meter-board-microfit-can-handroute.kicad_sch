	(generator_version "10.0")
	(uuid "59d580f2-180f-4c52-8215-2508c8a389e3")
	(paper "A2")
	(lib_symbols)
	(text "HOUR METER main board, Micro-Fit harness + CAN + RS232 variant (chip-down, JLCPCB in-stock parts)\nOne sheet per module: Power input, Opto inputs (817 2ch), RS485 (THVD2410), ESP32 core + USB (DevKitC), RTC (DS3231), EEPROM (AT24C256, SOIC-8),\nIMU (MPU-6500 + LIS3MDL), Ports (GPS, Qwiic, +5 V out, LEDs), IO (AIN1, DOUT1), CAN (TJA1051T/3), RS232 (MAX13223E) and Harness (J1 2x8, every field wire).\nSheet pins join by net name (labels at every pin). +5V, +3V3 and GND are global power symbols.\nThe vehicle supply (9-30 V) enters on J1 and feeds the on-board LM2596 5 V stage on the Power input sheet.\nReference designators are numbered per sheet: 1xx power, 2xx core, 3xx opto, 4xx RTC, 5xx EEPROM, 6xx IMU, 7xx RS485, 8xx ports, 9xx IO, 10xx CAN, 11xx RS232, J1 harness."
		(at 40 14 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "921dad1a-0d39-422e-bfcb-b5561974503d")
	)
