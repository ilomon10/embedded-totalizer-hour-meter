	(text "Hour meter main board (Micro-Fit + CAN + RS232), hand-routing copy: block diagram"
		(exclude_from_sim no)
		(at 15.24 12.7 0)
		(effects
			(font
				(size 3.0 3.0)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "6ca92e30-a799-5a84-b441-6142d5290468")
	)
	(text_box "HOW TO READ THIS SHEET\nEvery yellow block is one module of the board. Double-click a block (or use View > Navigate Hierarchy) to open its sheet.\nThe pins on a block are the module's inputs and outputs. Supply pins (+3V3, +5V) sit on the top edge, GND on the bottom edge.\nA line between two blocks is a real connection; its label is the net name, the same name the PCB editor shows on the track.\nA dot is a connection; two lines that cross without a dot are not connected.\nThe blocks are in the same places as the modules on the PCB: J1 on the left edge, the field modules next to it, the ESP32 in the middle, the I2C devices, LEDs and GPS on the right. Each block has the same name as its group on the PCB."
		(exclude_from_sim no)
		(at 15.24 18 0)
		(size 470 30)
		(margins 1.5 1.5 1.5 1.5)
		(stroke
			(width 0.1524)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left top)
		)
		(uuid "b53d0d27-f7b3-5c62-82f7-0a2735c00f97")
	)
	(text "PWR_FLAG (not a part): tells KiCad's electrical check that +5V, GND and VIN_LM are\npowered; they are fed through diodes, which the check does not count as supplies."
		(exclude_from_sim no)
		(at 444.5 345.44 0)
		(effects
