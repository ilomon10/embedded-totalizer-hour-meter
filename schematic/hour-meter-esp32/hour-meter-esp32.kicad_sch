	)
	(text "J1 = alternator D+/L, J2 = 12/24V pulse; pin 2 = vehicle GND"
		(at 15.24 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "74ae6835-cc08-40ed-a125-12353ca075e5")
	)
	(text "D1/D2 = reverse-polarity protection"
		(at 15.24 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a3202bb0-bdd4-4516-8638-613e3708cb77")
	)
	(text "R4/R6 = keep 24V systems inside the module's 24V rating"
		(at 15.24 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2518c456-c235-464d-8e06-0ccf6c3b8f0b")
	)
	(text "817 MODULE: REMOVE BOTH G JUMPERS (keeps isolation)"
		(at 15.24 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
				(color 200 0 0 1)
			)
			(justify left bottom)
		)
		(uuid "3f59b383-a51a-432e-8bee-21b7af37d739")
	)
	(text "Engine ON -> V1 pulled to G -> GPIO27 LOW (altActiveHigh = false)"
		(at 15.24 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5aac97e1-20ea-4629-b380-f91d72428923")
	)
	(text "R5/R7 = 47k pull-ups (not 10k: module has ~3k in series with V)"
