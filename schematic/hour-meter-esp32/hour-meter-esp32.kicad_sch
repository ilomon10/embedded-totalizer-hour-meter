		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4cfd26cb-6d2a-4577-aa0a-9d8c6bf6d5d3")
	)
	(text "C1 100nF = ignition-noise filter, C2 1nF = keeps fast pulses"
