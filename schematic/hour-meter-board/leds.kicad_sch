	(text "LEDs (D801-D803): three green indicator LEDs on the right board edge"
		(exclude_from_sim no)
		(at 15.24 12.7 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "fe17195a-3454-5eff-bc6c-22b3c6675807")
	)
	(text_box "WHAT IT DOES\nThree green side-view LEDs sit on the right board edge; they shine sideways through holes in the case wall.\nEach one lights when its ESP32 pin is high (3.3 V): the current flows pin -> 330 R -> LED -> GND, about 1.7 mA.\n\nPINS OF THIS MODULE (its block on the top sheet)\nEXP_IO18 (in): from ESP32 GPIO18: P1 LED (process indicator)\nEXP_IO19 (in): from ESP32 GPIO19: P2 LED (process indicator)\nEXP_IO5 (in): from ESP32 GPIO5: USR LED, free for the program (GPIO5 is a strapping pin: it may flicker at boot)\nGND: ground\nPower and ground reach the parts on this sheet only through these pins: the ground and supply symbols drawn on this sheet are local to it."
		(exclude_from_sim no)
		(at 15.24 17.78 0)
		(size 265 24.5)
		(margins 1.5 1.5 1.5 1.5)
		(stroke
			(width 0.1524)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fc282a5d-88ce-5278-b58c-d99731361d78")
	)
	(rectangle
		(start 121.92 83.82)
		(end 149.86 134.62)
		(stroke
			(width 0.1524)
			(type dash)
			(color 200 60 0 1)
		)
		(fill
			(type none)
		)
		(uuid "31de64f2-2d50-50fa-81e7-381cd9b70a68")
	)
	(text "board edge"
		(exclude_from_sim no)
		(at 122.52 84.42 0)
		(effects
			(font
				(size 1.0 1.0)
				(color 200 60 0 1)
			)
			(justify left top)
		)
		(uuid "2b383ee0-1a64-505d-866a-4471336d1579")
	)
	(text "D801-D803 sit on the right board edge with\ntheir lenses at the edge (they light sideways\nthrough the case wall): do not move them inward.\nR808-R810 can sit anywhere on their lines."
		(exclude_from_sim no)
		(at 154.94 88.9 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 200 60 0 1)
			)
			(justify left top)
		)
		(uuid "659969bc-69d4-53dd-9b4b-cf3315c3f940")
	)
	(text_box "PARTS AND THEIR JOBS\nD801: P1: green side-view LED (Lite-On LTST-S270TGKT, 1.6 x 1.2 mm) on GPIO18.\nD802: P2: the same LED on GPIO19.\nD803: USR: the same LED on GPIO5, free for the program.\nR808, R809, R810: 330 R series resistors: they set the LED current to about 1.7 mA from a 3.3 V pin (the LED takes about 2.7 V, the resistor the rest)."
		(exclude_from_sim no)
		(at 15.24 156 0)
		(size 155 16.3)
		(margins 1.5 1.5 1.5 1.5)
		(stroke
			(width 0.1524)
			(type solid)
