	(text "EEPROM (U501): 32 KB memory that keeps the saved data without power"
		(exclude_from_sim no)
		(at 15.24 12.7 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "1f6d0462-729d-5421-958b-6d6879b35bc3")
	)
	(text_box "WHAT IT DOES\nU501 is a 32 KB memory that keeps its contents without power. The firmware stores its saved data here (counters and\nsettings) and mirrors it in the ESP32's flash. The ESP32 reads and writes it over I2C (address 0x50).\nWriting is allowed as delivered; bridging the solder jumper JP501 makes the chip read-only.\n\nPINS OF THIS MODULE (its block on the top sheet)\n+3V3 (in): supply from the 3.3 V regulator (ESP32 + USB module)\nI2C_SCL, I2C_SDA (both ways): the shared I2C bus to the ESP32 (pull-ups R211/R212 are in the IMU module)\nGND: ground\nPower and ground reach the parts on this sheet only through these pins: the ground and supply symbols drawn on this sheet are local to it."
		(exclude_from_sim no)
		(at 15.24 17.78 0)
		(size 265 24.5)
		(margins 1.5 1.5 1.5 1.5)
		(stroke
			(width 0.1524)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8dd5f57e-2440-5688-a738-1bbedbd13e9c")
	)
	(rectangle
		(start 119.38 86.36)
		(end 170.18 130.81)
		(stroke
			(width 0.1524)
			(type dash)
			(color 200 60 0 1)
		)
		(fill
			(type none)
		)
		(uuid "cf1ad7dc-1b40-556b-9215-1c51fb27fe4a")
	)
	(text "keep together on the PCB"
		(exclude_from_sim no)
		(at 119.98 86.96 0)
		(effects
			(font
				(size 1.0 1.0)
				(color 200 60 0 1)
			)
			(justify left top)
		)
		(uuid "33a5a3d8-1ce8-519b-9e8d-1de49bdf62d8")
	)
	(text "C501 belongs to U501 pin 8 (VCC):\nwithin 2 mm of that pin, with a\nGND via beside its GND pad."
		(exclude_from_sim no)
		(at 172.72 86.36 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 200 60 0 1)
			)
			(justify left top)
		)
		(uuid "6ea68733-1ae2-5c37-bcde-a541d23c1f66")
	)
	(text_box "PARTS AND THEIR JOBS\nU501: AT24C256C 256 kbit (32 KB) I2C EEPROM (SOIC-8). A0, A1, A2 to GND = address 0x50. The firmware's data layout is 32 KB: fit a 24C256 or a 24C512.\nC501: 100 nF decoupling for U501 VCC (pin 8).\nR501: 10k pull-down on WP: writes allowed.\nJP501: Solder jumper, open as delivered. Bridge it to tie WP to +3V3: the chip becomes read-only.\nEE_WP: Net label: the write-protect line (U501 pin 7)."
		(exclude_from_sim no)
		(at 15.24 156 0)
		(size 155 18.35)
		(margins 1.5 1.5 1.5 1.5)
		(stroke
			(width 0.1524)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b448c8fe-39ef-55f8-a1dd-74a1b7637c5d")
	)
